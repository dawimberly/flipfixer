# Resend (contact form) — https://resend.com
# 1. Create a Resend account and API key.
# 2. Add theflipfixer.com as a domain and add the DNS records Resend shows.
# 3. After verification, mail can send from info@theflipfixer.com.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact form submissions are delivered
CONTACT_TO=jon@theflipfixer.com

# Optional — must use a verified @theflipfixer.com address in production
CONTACT_FROM=Flip Fixer Website <info@theflipfixer.com>
